# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portal_pagos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portal_pagos?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Transbank Webpay Plus - Integracion
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=change_me
WEBPAY_ENVIRONMENT=integration

# EduPay API
EDUPAY_API_URL=https://api.edupay.example.com
EDUPAY_API_TOKEN=change_me
NEXT_PUBLIC_TENANT_ID="colegio-pruebas"
EDUPAY_USE_DEMO_DATA=false

# Firma de webhooks de correo enviados por EduPay.
# Debe coincidir con el secret configurado para este Portal en GUARDIAN_EMAIL_WEBHOOKS.
# En una app que sirve un solo tenant, este valor es SOLO el secreto plano, no JSON.
EDUPAY_GUARDIAN_EMAIL_WEBHOOK_SECRET="change_me_at_least_32_characters"
# Alternativa multi-tenant:
# EDUPAY_GUARDIAN_EMAIL_WEBHOOK_SECRETS='{"colegio-pruebas":"change_me_at_least_32_characters"}'

# Scheduled Tasks / Cron
CRON_SECRET="[genera_un_token_seguro]"

# Auth / Sessions
NEXTAUTH_SECRET=change_me_32_bytes_minimum
NEXTAUTH_URL=http://localhost:3000

# Resend Email Configuration
RESEND_API_KEY="re_..." # Dejar vacío en local para activar el modo consola
EMAIL_FROM="Soporte Colegio Conquistadores <soporte@edupay.cl>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
